# ============================================================
# AUTOMATION BACKEND — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# Never commit .env to source control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ── Studio Identity ───────────────────────────────────────────
# Used in email templates, WhatsApp messages, and notifications
STUDIO_NAME=Your Studio Name
STUDIO_ADMIN_EMAIL=admin@yourdomain.com
# Google review link sent in the post-appointment WhatsApp message
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_LINK

# ── Business Type ─────────────────────────────────────────────
# Controls CRM label set. Values: tattoo_studio | hair_salon | barber | nail_salon | masseuse | restaurant
BUSINESS_TYPE=tattoo_studio

# ── Database (Neon PostgreSQL) ────────────────────────────────
# Get from: https://neon.tech → Project → Connection Details
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Redis (Upstash in production, Docker in local dev) ─────────
# Production: https://console.upstash.com → Redis → Connect → Node.js (ioredis)
# Connection string format: rediss://:YOUR_PASSWORD@YOUR_ENDPOINT:6379
# Local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Allowed Origins (CORS) ────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
CRM_URL=http://localhost:5174

# ── Resend (Email) ───────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY
# The From address must be a verified domain in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Your Studio Name

# ── Cloudinary (File Uploads) ─────────────────────────────────
# Each client creates their own free Cloudinary account.
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET

# ── Twilio (WhatsApp Automation) ──────────────────────────────
# Get from: https://console.twilio.com
# WHATSAPP_FROM must include the "whatsapp:" prefix, e.g. whatsapp:+14155238886
TWILIO_ACCOUNT_SID=ACREPLACE_WITH_YOUR_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# ── Google Calendar ──────────────────────────────────────────
# Set up at: https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ── Stripe (Payments) ────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
# Use test keys (sk_test_...) in development
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
# Webhook secret from: https://dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Feature Flags (global defaults; overridable per-client in DB) ──
# All flags are stored in the FeatureFlag DB table and controlled from the CRM God Mode panel.
# These env vars set the initial seed defaults only — changes at runtime go through the DB.
BOOKING_ENABLED=true
QUOTES_ENABLED=true
ANALYTICS_ENABLED=true
LEAD_CAPTURE_ENABLED=true
EMAIL_AUTOMATION_ENABLED=true
CALENDAR_SYNC_ENABLED=true
INVOICING_ENABLED=true
WHATSAPP_CONTACT_ENABLED=true
MANNEQUIN_ENABLED=true
REVIEWS_ENABLED=true
DEPOSIT_ENABLED=false
